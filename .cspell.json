{
  "version": "0.2",
  "ignorePaths": [
    ".cspell.json",
    ".git",
    ".secrets.baseline",
    "lib/aspera/data",
    "lib/transfer_pb.rb",
    "lib/transfer_services_pb.rb",
    "lib/transferd_pb.rb",
    "lib/transferd_services_pb.rb",
    "lib/aspera/schema/IBM*",
    "docs/README.md",
    "docs/aspera.conf.xsd",
    "docs/spec.schema.json",
    "docs/test_env.conf",
    "**/*.tex",
    "**/*.html",
    "**/*.pptx",
    "**/*.svg"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-aspera",
      "path": "./.cspell/aspera.dict",
      "addWords": true
    },
    {
      "name": "project-ruby",
      "path": "./.cspell/ruby.dict",
      "addWords": true
    },
    {
      "name": "project-tools",
      "path": "./.cspell/tools.dict",
      "addWords": true
    }
  ],
  "useGitignore": true,
  "dictionaries": ["project-aspera", "project-ruby", "project-tools", "ruby", "bash", "powershell", "html", "css", "fonts"],
  "words": [],
  "ignoreWords": [],
  "import": [],
  "enableFiletypes": ["markdown", "shellscript"],
  "patterns": [
    {
      "name": "markdown_code_block",
      "pattern": "/^\\s*```(.|\\n)+?^\\s*```/gm"
    },
    {
      "name": "code_inline",
      "pattern": "/`.*?`/g"
    },
    {
      "name": "markdown_reference",
      "pattern": "/\\[.*?\\](\\(.*?\\))/g"
    },
    {
      "name": "quoted_special_words",
      "pattern": "/\".*?\"/g"
    },
    {
      "name": "embedded_ruby_code_block",
      "pattern": "/<%[^%]*%>/g"
    },
    {
      "name": "single_token_string",
      "pattern": "/([\"'])[^\\s\"']+\\1/g"
    },
    {
      "name": "ruby_percent_array",
      "pattern": "/%[iIwW]\\[[^\\]]*\\]/g"
    },
    {
      "name": "command_option",
      "pattern": "/(?<![\\w-])--?[a-zA-Z][\\w.-]*(=\\S*)?/g"
    },
    {
      "name": "snake_case_identifier",
      "pattern": "/\\b[a-zA-Z0-9]+(_[a-zA-Z0-9]+)+\\b/g"
    },
    {
      "name": "data_uri",
      "pattern": "/\\bdata:[\\w.+-]+\\/[\\w.+-]+[;,][^\"]*/g"
    }
  ],
  "ignoreRegExpList": ["code_inline", "single_token_string", "ruby_percent_array", "command_option", "data_uri"],
  "languageSettings": [
    {
      "languageId": "markdown",
      "ignoreRegExpList": [
        "markdown_code_block",
        "quoted_special_words",
        "embedded_ruby_code_block",
        "markdown_reference"
      ]
    }
  ],
  "overrides": [
    {
      "filename": "tests/tests.yml",
      "ignoreRegExpList": ["snake_case_identifier"]
    }
  ]
}
