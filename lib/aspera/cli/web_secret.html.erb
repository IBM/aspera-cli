<%# Content of the secret page, in layout of Aspera::WebPage %>
<% if state.eql?(:form) %>
        <div class="icon-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="#0f62fe" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="6" y="13" width="20" height="15" rx="3"/>
                <path d="M10 13V9a6 6 0 0 1 12 0v4"/>
                <circle cx="16" cy="20.5" r="2" fill="#0f62fe"/>
            </svg>
        </div>

        <h1>Secret request</h1>
<% if requester %>
        <p><%= h name %> needs the secret <span class="client"><%= h prompt %></span> to execute a command requested by the <%= h requester %>.</p>
        <p>The secret is sent to <%= h name %> only: the <%= h requester %> does not see it.</p>
<% else %>
        <p><%= h name %> needs the secret <span class="client"><%= h prompt %></span> to execute your command.</p>
<% end %>
<% if error %>
        <p class="error"><%= h error %></p>
<% end %>

        <form method="POST" action="<%= h action_url %>">
<% if access_code_required %>
            <label class="secret">Server access code
                <input type="password" name="access_code" autocomplete="off" required autofocus>
            </label>
<% end %>
            <label class="secret">Secret: <%= h prompt %>
                <input type="password" name="secret" autocomplete="off" required<%= ' autofocus' unless access_code_required %>>
            </label>
            <div class="actions">
                <button class="allow" type="submit" name="decision" value="submit">Submit</button>
                <button class="deny"  type="submit" name="decision" value="cancel" formnovalidate>Cancel</button>
            </div>
        </form>
<% elsif state.eql?(:received) %>
        <div class="icon-circle ok">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#24a148" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 16 13 23 26 9"/>
            </svg>
        </div>

        <h1>Secret received</h1>
        <p>You can close this window and return to your <%= h(requester || 'terminal') %>.</p>
<% else %>
        <div class="icon-circle ko">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="#da1e28" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="9" y1="9" x2="23" y2="23"/>
                <line x1="23" y1="9" x2="9" y2="23"/>
            </svg>
        </div>

<% if state.eql?(:cancelled) %>
        <h1>Secret request cancelled</h1>
        <p>The command will fail. You can close this window and return to your <%= h(requester || 'terminal') %>.</p>
<% else %>
        <h1>Unknown secret request</h1>
        <p>This request is unknown, expired, or already answered.</p>
<% end %>
<% end %>

