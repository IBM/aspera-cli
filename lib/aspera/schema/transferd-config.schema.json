# DO NOT EDIT THIS FILE MANUALLY
# This file is automatically downloaded from:
# https://raw.githubusercontent.com/laurent-martin/aspera-api-examples/refs/heads/main/openapi/transferd-config.schema.json
# Use 'rake tools:openapi' to update this file

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Matches transferd 1.1.10 (source of truth: internal/config/config.go in the transferd repository). Durations are in seconds.",
  "title": "IBM Aspera Transfer SDK daemon (transferd) configuration",
  "description": "Configuration file of transferd, in JSON or YAML. Without option --config (-c), transferd reads ../etc/transferd.json relative to the directory of the transferd executable, then /etc/transferd/transferd.json, and if neither exists uses built-in defaults. transferd ignores unknown keys, so a misspelled key silently has no effect: validate the file against this schema to catch it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional URI or path of this schema, used by editors for completion and validation. Ignored by transferd."
    },
    "log_directory": {
      "type": "string",
      "description": "Directory of the transferd log file transferd.log (rotated at 10 MiB, 10 files kept). A relative path is resolved from the directory of the transferd executable. The directory is created if missing. Empty or omitted: logs are written to standard output.",
      "examples": ["/var/log/aspera", "../var/log"]
    },
    "log_level": {
      "type": "string",
      "description": "Level of detail of the transferd log, from most (trace) to least (panic) verbose. Omitted or unrecognized value: info.",
      "enum": ["trace", "debug", "info", "warning", "error", "fatal", "panic"],
      "default": "info"
    },
    "log_format": {
      "type": "string",
      "description": "Format of the transferd log: text for human-readable lines, json for one JSON object per line. Any value other than text gives json.",
      "enum": ["text", "json"],
      "default": "text"
    },
    "address": {
      "type": "string",
      "description": "IP address or host name on which the gRPC API listens. Use 0.0.0.0 to listen on all IPv4 interfaces (for example in a container); when not listening on a loopback address, consider enabling tls and authentication. Overridden by environment variable TRANSFERD_ADDRESS, and by option --address (-a), which takes precedence.",
      "default": "127.0.0.1",
      "examples": ["127.0.0.1", "0.0.0.0"]
    },
    "port": {
      "type": "integer",
      "description": "TCP port on which the gRPC API listens. 0 or omitted: a free port is selected at startup; it is written in the log and in file transferd.<port>.optport of runtime_dir. The configuration file shipped with the SDK sets 55002. Overridden by environment variable TRANSFERD_PORT, and by option --port (-p), which takes precedence.",
      "minimum": 0,
      "maximum": 65535,
      "default": 0,
      "examples": [55002]
    },
    "runtime_dir": {
      "type": "string",
      "description": "Directory for runtime files. When port is 0, transferd writes the selected port in file transferd.<port>.optport there. Created with owner-only permissions if missing. Omitted: ../var/run/aspera relative to the directory of the transferd executable.",
      "examples": ["/var/run/aspera"]
    },
    "reflection": {
      "type": "boolean",
      "description": "Enables the gRPC server reflection service, so that tools such as grpcurl or grpcui can list and call the API without the transferd.proto file. Useful for debugging; leave disabled otherwise.",
      "default": false
    },
    "workers": {
      "type": "object",
      "description": "Transfer execution and retention.",
      "additionalProperties": false,
      "properties": {
        "max_concurrent": {
          "type": "integer",
          "description": "Maximum number of transfers running at the same time. Additional transfers wait in a queue until a running one ends. 0 or omitted: 100.",
          "minimum": 0,
          "default": 100,
          "examples": [10]
        },
        "transfer_cleaning_period": {
          "type": "integer",
          "description": "Interval, in seconds, at which transferd removes ended transfers older than transfer_max_age. 0 or omitted: 3600 (1 hour).",
          "minimum": 0,
          "default": 3600
        },
        "transfer_max_age": {
          "type": "integer",
          "description": "Time, in seconds, during which an ended transfer remains known to transferd (status queries, events) before it can be removed. Removal happens at the next cleaning, so a transfer may remain up to transfer_max_age + transfer_cleaning_period. 0 or omitted: 7200 (2 hours).",
          "minimum": 0,
          "default": 7200,
          "examples": [86400]
        }
      }
    },
    "fasp_management": {
      "type": "object",
      "description": "Management port on which the ascp processes started by transferd report transfer progress.",
      "additionalProperties": false,
      "properties": {
        "promiscuous_mode_enabled": {
          "type": "boolean",
          "description": "When true, transferd also reports transfers of ascp processes that it did not start. So that those processes find the management port, transferd writes it in file transferd.<port>.optport of directory ../var/run/aspera, relative to the FASP runtime bin directory. Those ascp processes must use the same FASP runtime as transferd (see fasp_runtime).",
          "default": false
        },
        "port": {
          "type": "integer",
          "description": "TCP port of the management server. 0 or omitted: a free port is selected at startup. Overridden by environment variable TRANSFERD_MGMT_PORT, and by option --mgmtport (-P), which takes precedence.",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "examples": [23456]
        },
        "address": {
          "type": "string",
          "description": "IP address on which the management server listens. Change it only when ascp must reach transferd through an interface other than loopback. Overridden by environment variable TRANSFERD_MGMT_ADDRESS, and by option --mgmtaddress (-A), which takes precedence.",
          "default": "127.0.0.1",
          "examples": ["127.0.0.1"]
        }
      }
    },
    "fasp_runtime": {
      "type": "object",
      "description": "FASP runtime (ascp, async, license, aspera.conf) used for transfers. Omitted: the runtime embedded in the SDK is used. When this section is present, set use_embedded explicitly: if it is not true, user_defined is required.",
      "additionalProperties": false,
      "properties": {
        "use_embedded": {
          "type": "boolean",
          "description": "true: use the FASP runtime embedded in the SDK, and ignore user_defined. false: use the runtime located by user_defined. Omitted while the fasp_runtime section is present: false.",
          "examples": [true]
        },
        "force_version": {
          "type": "string",
          "description": "Accepted for backward compatibility. Has no effect.",
          "deprecated": true
        },
        "user_defined": {
          "type": "object",
          "description": "Location of a separately installed FASP runtime. Required when use_embedded is not true, ignored otherwise. Both directories must exist at startup.",
          "additionalProperties": false,
          "required": ["bin", "etc"],
          "properties": {
            "bin": {
              "type": "string",
              "description": "Directory containing the ascp and async executables. A relative path is resolved from the working directory of transferd.",
              "minLength": 1,
              "examples": ["/opt/aspera/bin"]
            },
            "etc": {
              "type": "string",
              "description": "Directory containing the license file aspera-license and the configuration file aspera.conf. A relative path is resolved from the working directory of transferd.",
              "minLength": 1,
              "examples": ["/opt/aspera/etc"]
            }
          }
        },
        "log": {
          "type": "object",
          "description": "Default logging of ascp, for transfers whose request configuration does not set localLog or logLevel. Does not apply to async.",
          "additionalProperties": false,
          "properties": {
            "dir": {
              "type": "string",
              "description": "Directory where ascp writes its log (ascp option -L). Empty or omitted: default location of ascp.",
              "examples": ["/var/log/aspera"]
            },
            "level": {
              "type": "integer",
              "description": "Level of detail of the ascp log: 0 for basic information (files transferred, transfer rate), 1 to 4 for increasingly detailed debug messages (ascp options -D to -DDDD).",
              "minimum": 0,
              "maximum": 4,
              "default": 0
            }
          }
        },
        "extra_config": {
          "type": "array",
          "description": "Extra command line options added to the executables started for transfers. Does not apply to async.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": {
                "type": "string",
                "description": "End of the path of the executable to which options are added, for example ascp (ascp.exe on Windows). Only the first matching entry is used.",
                "minLength": 1,
                "examples": ["ascp", "ascp.exe"]
              },
              "options": {
                "type": "array",
                "description": "Options added to the command line, one argument per item, before the transfer arguments.",
                "items": {
                  "type": "string"
                },
                "examples": [["--save-before-overwrite"]]
              }
            }
          }
        }
      },
      "if": {
        "required": ["use_embedded"],
        "properties": {
          "use_embedded": {
            "const": true
          }
        }
      },
      "else": {
        "required": ["user_defined"]
      }
    },
    "tls": {
      "type": "object",
      "description": "TLS for the gRPC API. When enabled, clients must connect using TLS.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enables TLS. certificate and key are then required.",
          "default": false
        },
        "certificate": {
          "type": "string",
          "description": "Path of the PEM server certificate file, which may include intermediate certificates. A relative path is resolved from the working directory of transferd.",
          "minLength": 1,
          "examples": ["/etc/transferd/server.crt"]
        },
        "key": {
          "type": "string",
          "description": "Path of the PEM private key file matching certificate. A relative path is resolved from the working directory of transferd.",
          "minLength": 1,
          "examples": ["/etc/transferd/server.key"]
        },
        "min_tls_version": {
          "type": "string",
          "description": "Minimum TLS version accepted from clients. Omitted or other value: TLSv12.",
          "enum": ["TLSv12", "TLSv13"],
          "default": "TLSv12"
        }
      },
      "if": {
        "required": ["enabled"],
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["certificate", "key"]
      }
    },
    "authentication": {
      "type": "object",
      "description": "API key authentication of clients of the gRPC API.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Requires every call to carry the API key; other calls are rejected with status UNAUTHENTICATED. api_key is then required.",
          "default": false
        },
        "api_key": {
          "type": "string",
          "description": "Value that clients must send in gRPC request metadata entry api_key. It is stored in clear text: restrict read access to this file.",
          "minLength": 1,
          "examples": ["change-me-to-a-long-random-value"]
        }
      },
      "if": {
        "required": ["enabled"],
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["api_key"]
      }
    },
    "api_time_settings": {
      "type": "object",
      "description": "Keepalive and connection lifetime settings of the gRPC API server, in seconds.",
      "additionalProperties": false,
      "properties": {
        "max_conn_idle": {
          "type": "integer",
          "description": "Time after which a client connection with no ongoing call is closed. 0 or omitted: 86400 (24 hours).",
          "minimum": 0,
          "default": 86400,
          "examples": [120]
        },
        "max_conn_age": {
          "type": "integer",
          "description": "Maximum lifetime of a client connection, with a random variation of +/-10%; the client must then reconnect. 0 or omitted: no limit.",
          "minimum": 0,
          "default": 0,
          "examples": [3600]
        },
        "max_conn_age_grace": {
          "type": "integer",
          "description": "Additional time given to ongoing calls once max_conn_age is reached, before the connection is forcibly closed. 0 or omitted: no limit.",
          "minimum": 0,
          "default": 0,
          "examples": [10]
        },
        "time": {
          "type": "integer",
          "description": "Time without activity from a client after which the server pings it to check that the connection is still alive. 0 or omitted: 7200 (2 hours).",
          "minimum": 0,
          "default": 7200,
          "examples": [60]
        },
        "timeout": {
          "type": "integer",
          "description": "Time the server waits for activity after a keepalive ping before closing the connection. 0 or omitted: 20.",
          "minimum": 0,
          "default": 20,
          "examples": [3]
        }
      }
    }
  },
  "examples": [
    {
      "address": "127.0.0.1",
      "port": 55002,
      "workers": {
        "max_concurrent": 10
      },
      "fasp_management": {
        "promiscuous_mode_enabled": false,
        "port": 23456
      },
      "fasp_runtime": {
        "use_embedded": true
      }
    }
  ]
}
