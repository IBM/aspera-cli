<mxfile host="drawio" compressed="false">
  <diagram name="login-flow" id="login-flow">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="800" pageHeight="700" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="h-ascli" value="&lt;b&gt;ascli&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=13;fillColor=#5E35B1;strokeColor=#5E35B1;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="20" y="0" width="180" height="48" as="geometry"/></mxCell>
        <mxCell id="life-ascli" style="endArrow=none;dashed=1;html=1;strokeColor=#5E35B1;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="48" as="sourcePoint"/><mxPoint x="110" y="640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h-browser" value="&lt;b&gt;Web browser&lt;br&gt;(user)&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=13;fillColor=#455A64;strokeColor=#455A64;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="300" y="0" width="180" height="48" as="geometry"/></mxCell>
        <mxCell id="life-browser" style="endArrow=none;dashed=1;html=1;strokeColor=#455A64;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="48" as="sourcePoint"/><mxPoint x="390" y="640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h-server" value="&lt;b&gt;Server&lt;br&gt;(Aspera application)&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=13;fillColor=#00796B;strokeColor=#00796B;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="580" y="0" width="180" height="48" as="geometry"/></mxCell>
        <mxCell id="life-server" style="endArrow=none;dashed=1;html=1;strokeColor=#00796B;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="48" as="sourcePoint"/><mxPoint x="670" y="640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n1" value='&lt;b&gt;1&lt;/b&gt; Generate random &lt;font face="Courier New"&gt;state&lt;/font&gt;.&lt;br&gt;Listen on the loopback &lt;font face="Courier New"&gt;redirect_uri&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D1C4E9;strokeColor=#5E35B1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="10" y="72" width="200" height="48" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;2&lt;/b&gt; Open login URL" style="endArrow=block;endFill=1;html=1;strokeColor=#424242;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="178" as="sourcePoint"/><mxPoint x="390" y="178" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="&lt;b&gt;3&lt;/b&gt; GET login page" style="endArrow=block;endFill=1;html=1;strokeColor=#424242;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="242" as="sourcePoint"/><mxPoint x="670" y="242" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n4" value="&lt;b&gt;4&lt;/b&gt; User logs in&lt;br&gt;(password, SSO, SAML IdP)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#CFD8DC;strokeColor=#455A64;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="290" y="284" width="200" height="44" as="geometry"/></mxCell>
        <mxCell id="m5" value='&lt;b&gt;5&lt;/b&gt; HTTP 302 to &lt;font face="Courier New"&gt;redirect_uri&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;strokeColor=#424242;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="382" as="sourcePoint"/><mxPoint x="390" y="382" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value='&lt;b&gt;6&lt;/b&gt; GET &lt;font face="Courier New"&gt;localhost:12345/?code=...&amp;amp;state=...&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;strokeColor=#424242;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="446" as="sourcePoint"/><mxPoint x="110" y="446" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n7" value='&lt;b&gt;7&lt;/b&gt; Check &lt;font face="Courier New"&gt;state&lt;/font&gt;; browser shows "you can close"; stop listening' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D1C4E9;strokeColor=#5E35B1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="10" y="488" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="m8" value='&lt;b&gt;8&lt;/b&gt; POST token request (&lt;font face="Courier New"&gt;code&lt;/font&gt;)' style="endArrow=block;endFill=1;html=1;strokeColor=#424242;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="594" as="sourcePoint"/><mxPoint x="670" y="594" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="&lt;b&gt;9&lt;/b&gt; Access token (and refresh token)" style="endArrow=block;endFill=1;html=1;strokeColor=#424242;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="658" as="sourcePoint"/><mxPoint x="110" y="658" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n10" value="&lt;b&gt;10&lt;/b&gt; Token saved in cache,&lt;br&gt;refreshed without browser" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D1C4E9;strokeColor=#5E35B1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="10" y="700" width="200" height="44" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
